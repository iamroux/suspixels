# app config
NODE_ENV=production
APP_PORT=3002
APP_TITLE=Suspixels
APP_DESCRIPTION="A pixel art game engine for the web"
APP_VERSION=1.0.0
JWT_SECRET=your_very_long_random_jwt_secret_here
# For local: http://localhost:8000,http://localhost:3000
# For production: leave empty or set specific origins (e.g., https://yourdomain.com)
APP_CORS_ORIGINS=

# database config
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=pixel_canvas
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false

# redis config
REDIS_HOST=localhost
REDIS_PORT=6379